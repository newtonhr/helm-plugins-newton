    {
      "id": "BEH-4",
      "title": "Offer pay after delivery (invoice)",
      "status": "missing",
      "observation": "Payments: card, bank transfer, cash on delivery. No invoice or pay-later option at the payment step.",
      "evidence": "pages/path/client_checkout_payment.html",
      "hypothesis": "If shoppers can pay after delivery, more of them finish the order, because the payment risk moves off them.",
      "grade": "A",
      "effort": "M",
      "source": "Berg, Burg, Keil & Puri 2025 (RCT, German furniture shop)",
      "measure": "Payment-step completion",
      "test_design": "Before/after with dated log",
      "acceptance_criteria": "Invoice option live through a provider that carries the credit risk; consumer-credit rules checked."
    },
    {
      "id": "PATH-1",
      "title": "Shorten the path from landing to payment",
      "status": "partial",
      "observation": "Client desktop needs 9 interactions to the first checkout form; best competitor needs 6.",
      "evidence": "path.json",
      "hypothesis": "If the path to the first form drops from 9 to 6 interactions, more carts reach checkout.",
      "grade": "B",
      "effort": "S",
      "source": "Unal & Park 2023 (quasi-experiment)",
      "measure": "Interactions to first checkout form; cart-to-checkout rate",
      "test_design": "Before/after with dated log",
      "acceptance_criteria": "path_metrics.py reports 6 or fewer on desktop and mobile."
    },
    {
      "id": "BEH-2",
      "title": "Show true low stock on product pages",
      "status": "missing",
      "observation": "No stock level on sampled product pages.",
      "evidence": "evidence/screenshot_pdp.jpg",
      "hypothesis": "If the page shows the real remaining stock when it is low, shoppers who want the item decide sooner.",
      "grade": "A",
      "effort": "S",
      "source": "Qubit 2017; Cui, Zhang & Bassamboo 2019",
      "truth_source": "POS stock, synced hourly",
      "measure": "Add-to-cart rate on low-stock SKUs",
      "test_design": "Randomized SKU-level rollout",
      "acceptance_criteria": "Signal shows only when POS stock is at or below 3; spot check of 50 SKUs matches POS."
    },
    {
      "id": "PATH-3",
      "title": "Buy and checkout buttons exist, work and are not covered",
      "status": "done",
      "observation": "Add-to-cart and checkout buttons work on desktop and mobile; nothing covers them, also with the cookie banner unanswered.",
